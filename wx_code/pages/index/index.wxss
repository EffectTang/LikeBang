.page {
  padding: 24rpx;
}
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.search-box {
  flex: 1;
  background: #fff;
  border-radius: 40rpx;
  padding: 0 32rpx;
}
.search-input {
  height: 72rpx;
  font-size: 28rpx;
}
.create-btn {
  background: #409eff;
  color: #fff;
  border-radius: 40rpx;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  white-space: nowrap;
}

.cat-bar {
  white-space: nowrap;
  margin-bottom: 20rpx;
}
.cat {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  background: #fff;
  color: #606266;
  border-radius: 30rpx;
  font-size: 26rpx;
}
.cat.active {
  background: #409eff;
  color: #fff;
}

.rank-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.card-cover {
  display: block;
  width: 100%;
  height: 260rpx;
}
.cover-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #409eff 0%, #66b1ff 100%);
  font-size: 72rpx;
}
.card-body {
  padding: 20rpx 24rpx 24rpx;
}
.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #303133;
}
.card-desc {
  color: #909399;
  font-size: 26rpx;
  margin: 8rpx 0 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.card-meta {
  display: flex;
  gap: 28rpx;
  color: #606266;
  font-size: 24rpx;
}
.card-foot {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}
.creator {
  color: #909399;
  font-size: 24rpx;
}
