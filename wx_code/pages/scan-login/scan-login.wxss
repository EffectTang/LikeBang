.scan-page {
  padding: 80rpx 48rpx;
}
.brand {
  text-align: center;
  margin-bottom: 60rpx;
}
.logo {
  font-size: 96rpx;
}
.brand-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #409eff;
  margin-top: 8rpx;
}
.panel {
  background: #fff;
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.msg {
  color: #606266;
  font-size: 28rpx;
}
.msg.ok {
  color: #67c23a;
  font-weight: 600;
}
.who {
  font-size: 40rpx;
  font-weight: 700;
  color: #303133;
  margin: 24rpx 0 8rpx;
  word-break: break-all;
}
.sub {
  color: #909399;
  font-size: 24rpx;
  margin-bottom: 40rpx;
}
.confirm {
  margin-top: 40rpx;
  height: 88rpx;
  line-height: 88rpx;
}
