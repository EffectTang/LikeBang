.login-page {
  padding: 60rpx 48rpx;
}
.brand {
  text-align: center;
  margin-bottom: 48rpx;
}
.logo {
  font-size: 96rpx;
}
.brand-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #409eff;
  margin-top: 8rpx;
}
.brand-sub {
  color: #909399;
  font-size: 26rpx;
  margin-top: 8rpx;
}
.tabs {
  display: flex;
  background: #f0f2f5;
  border-radius: 40rpx;
  padding: 6rpx;
  margin-bottom: 40rpx;
}
.tab {
  flex: 1;
  text-align: center;
  line-height: 68rpx;
  border-radius: 36rpx;
  color: #909399;
  font-size: 30rpx;
}
.tab.active {
  background: #fff;
  color: #409eff;
  font-weight: 600;
}
.field {
  margin-bottom: 28rpx;
}
.label {
  display: block;
  font-size: 26rpx;
  color: #606266;
  margin-bottom: 12rpx;
}
.input {
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
}
.submit {
  margin-top: 20rpx;
  height: 88rpx;
  line-height: 88rpx;
}
.tip {
  margin-top: 40rpx;
  text-align: center;
  color: #c0c4cc;
  font-size: 22rpx;
  line-height: 1.6;
}
