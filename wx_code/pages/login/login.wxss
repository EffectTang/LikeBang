.login-page {
  padding: 60rpx 48rpx;
}
.brand {
  text-align: center;
  margin-bottom: 48rpx;
}
.logo {
  font-size: 96rpx;
}
.brand-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #409eff;
  margin-top: 8rpx;
}
.brand-sub {
  color: #909399;
  font-size: 26rpx;
  margin-top: 8rpx;
}
.tabs {
  display: flex;
  background: #f0f2f5;
  border-radius: 40rpx;
  padding: 6rpx;
  margin-bottom: 40rpx;
}
.tab {
  flex: 1;
  text-align: center;
  line-height: 68rpx;
  border-radius: 36rpx;
  color: #909399;
  font-size: 30rpx;
}
.tab.active {
  background: #fff;
  color: #409eff;
  font-weight: 600;
}

/* 白卡片表单：整卡白底与页面浅灰底隔离，行内左标签右输入、行间分割线 */
.fields {
  background: #fff;
  border-radius: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.field {
  display: flex;
  align-items: center;
  gap: 24rpx;
  border-bottom: 1rpx solid #f0f2f5;
}
.field:last-child {
  border-bottom: none;
}
.label {
  flex-shrink: 0;
  width: 120rpx;
  font-size: 28rpx;
  color: #606266;
}
.input {
  flex: 1;
  min-width: 0;
  height: 104rpx;
  /* 原生 input 垂直位置只由 line-height 决定：行高=框高才居中 */
  line-height: 104rpx;
  font-size: 30rpx;
  color: #303133;
}
.ph {
  color: #c0c4cc;
  font-size: 26rpx;
}

.submit {
  height: 88rpx;
  width: 100%;
  /* button 文字居中用 flex，不吃基础库默认 line-height/padding */
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.divider {
  display: flex;
  align-items: center;
  text-align: center;
  color: #c0c4cc;
  font-size: 24rpx;
  margin: 32rpx 0;
}
.divider::before,
.divider::after {
  content: '';
  flex: 1;
  height: 1px;
  background: #ebeef5;
}
.divider text {
  padding: 0 24rpx;
}
.btn-wx {
  background: #07c160;
  color: #fff;
  border: none;
  border-radius: 40rpx;
  height: 88rpx;
  width: 100%;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.tip {
  margin-top: 40rpx;
  text-align: center;
  color: #c0c4cc;
  font-size: 22rpx;
  line-height: 1.6;
}
