<view class="login-page">
  <view class="brand">
    <view class="logo">🏆</view>
    <view class="brand-title">榜了个榜</view>
    <view class="brand-sub">发起观点排行榜，把共识投出来</view>
  </view>

  <!-- 模式切换 -->
  <view class="tabs">
    <view class="tab {{mode === 'login' ? 'active' : ''}}" bindtap="switchMode" data-mode="login">登录</view>
    <view class="tab {{mode === 'register' ? 'active' : ''}}" bindtap="switchMode" data-mode="register">注册</view>
  </view>

  <!-- 白卡片表单：左标签右输入、行间分割线，label 与输入框视觉隔离 -->
  <view class="fields">
    <view class="field">
      <text class="label">用户名</text>
      <input class="input" placeholder="4~32 位字母/数字/下划线" placeholder-class="ph"
             value="{{form.username}}" bindinput="onInput" data-key="username" />
    </view>

    <view class="field" wx:if="{{mode === 'register'}}">
      <text class="label">昵称</text>
      <input class="input" placeholder="展示名称" placeholder-class="ph"
             value="{{form.nickname}}" bindinput="onInput" data-key="nickname" />
    </view>

    <view class="field">
      <text class="label">密码</text>
      <input class="input" password placeholder="6~32 位" placeholder-class="ph"
             value="{{form.password}}" bindinput="onInput" data-key="password" />
    </view>

    <view class="field" wx:if="{{mode === 'register'}}">
      <text class="label">邮箱</text>
      <input class="input" placeholder="name@example.com" placeholder-class="ph"
             value="{{form.email}}" bindinput="onInput" data-key="email" />
    </view>

    <view class="field" wx:if="{{mode === 'register'}}">
      <text class="label">手机号</text>
      <input class="input" type="number" placeholder="选填" placeholder-class="ph"
             value="{{form.phone}}" bindinput="onInput" data-key="phone" />
    </view>
  </view>

  <button class="btn-primary submit" loading="{{submitting}}" bindtap="submit">
    {{mode === 'login' ? '登录' : '注册并登录'}}
  </button>

  <view class="divider"><text>或</text></view>

  <button class="btn-wx" loading="{{wxSubmitting}}" bindtap="wxAuthLogin">微信一键登录</button>

  <view class="tip">
    微信一键登录：新用户自动注册，老用户凭微信直接登录。
  </view>
</view>

<!-- 新用户首次微信登录后的一次性“完善资料”引导（可跳过） -->
<view wx:if="{{showFill}}" class="fill-mask">
  <view class="fill-card">
    <view class="fill-title">完善你的资料</view>
    <view class="fill-sub">设个昵称和头像会让你更容易被认出来（也可先跳过，稍后在“我的资料”修改）</view>

    <!-- 头像：外层 view 定形保证正圆，内层透明 button 铺满承接 chooseAvatar（同 profile 页手法） -->
    <view class="fill-avatar-box">
      <image wx:if="{{fillAvatarPrev}}" class="fill-avatar-img" src="{{fillAvatarPrev}}" mode="aspectFill" />
      <view wx:else class="fill-avatar-ph">＋</view>
      <button class="fill-avatar-overlay" open-type="chooseAvatar" bindchooseavatar="onFillChooseAvatar"></button>
    </view>
    <view class="fill-avatar-tip">点击选头像（推荐用微信头像）</view>

    <input class="fill-input" type="nickname" value="{{fillNickname}}" maxlength="32"
           placeholder="点击填写昵称（可一键用微信昵称）" placeholder-class="fill-ph"
           bindinput="onFillNickname" bindblur="onFillNickname" />

    <button class="btn-primary fill-save" loading="{{fillSaving}}" bindtap="saveFill">保存并进入</button>
    <view class="fill-skip" bindtap="skipFill">先跳过</view>
  </view>
</view>
