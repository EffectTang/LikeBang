<view class="login-page">
  <view class="brand">
    <view class="logo">🏆</view>
    <view class="brand-title">榜了个榜</view>
    <view class="brand-sub">发起观点排行榜，把共识投出来</view>
  </view>

  <!-- 模式切换 -->
  <view class="tabs">
    <view class="tab {{mode === 'login' ? 'active' : ''}}" bindtap="switchMode" data-mode="login">登录</view>
    <view class="tab {{mode === 'register' ? 'active' : ''}}" bindtap="switchMode" data-mode="register">注册</view>
  </view>

  <view class="form">
    <view class="field">
      <text class="label">用户名</text>
      <input class="input" placeholder="4~32 位字母/数字/下划线" value="{{form.username}}"
             bindinput="onInput" data-key="username" />
    </view>

    <view class="field" wx:if="{{mode === 'register'}}">
      <text class="label">昵称</text>
      <input class="input" placeholder="展示名称" value="{{form.nickname}}"
             bindinput="onInput" data-key="nickname" />
    </view>

    <view class="field">
      <text class="label">密码</text>
      <input class="input" password placeholder="6~32 位" value="{{form.password}}"
             bindinput="onInput" data-key="password" />
    </view>

    <view class="field" wx:if="{{mode === 'register'}}">
      <text class="label">邮箱</text>
      <input class="input" placeholder="name@example.com" value="{{form.email}}"
             bindinput="onInput" data-key="email" />
    </view>

    <view class="field" wx:if="{{mode === 'register'}}">
      <text class="label">手机号（选填）</text>
      <input class="input" type="number" placeholder="选填" value="{{form.phone}}"
             bindinput="onInput" data-key="phone" />
    </view>

    <button class="btn-primary submit" loading="{{submitting}}" bindtap="submit">
      {{mode === 'login' ? '登录' : '注册并登录'}}
    </button>

    <view class="divider"><text>或</text></view>

    <button class="btn-wx" loading="{{wxSubmitting}}" bindtap="wxAuthLogin">微信一键登录</button>
  </view>

  <view class="tip">
    微信一键登录：新用户自动注册，老用户凭微信直接登录。开发默认超管 admin / root。
  </view>
</view>
