.detail-page {
  padding-bottom: 40rpx;
}

/* 头部 */
.hero {
  background: #fff;
  padding: 24rpx;
}
.hero-cover {
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}
.hero-title {
  font-size: 38rpx;
  font-weight: 700;
}
.hero-desc {
  color: #606266;
  font-size: 26rpx;
  margin-top: 10rpx;
}
.hero-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 20rpx;
  color: #909399;
  font-size: 24rpx;
  margin-top: 16rpx;
}
.creator-link {
  color: #409eff;
}

/* 管理栏 */
.manage-bar {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fdf6ec;
}
.mbtn {
  background: #fff;
  color: #409eff;
  border: 1rpx solid #409eff;
  border-radius: 30rpx;
  font-size: 24rpx;
}
.mbtn.danger {
  color: #f56c6c;
  border-color: #f56c6c;
}

/* 排名项 */
.item-card {
  background: #fff;
  border-radius: 16rpx;
  margin: 24rpx;
  padding: 24rpx;
}
.item-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.rank-badge {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  background: #909399;
  color: #fff;
  font-weight: 700;
  flex-shrink: 0;
}
.item-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.item-name {
  font-size: 32rpx;
  font-weight: 600;
}
.item-source {
  color: #909399;
  font-size: 24rpx;
  margin-top: 4rpx;
}
.item-desc {
  color: #606266;
  font-size: 26rpx;
  margin-top: 6rpx;
}

.item-ops {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  flex-wrap: wrap;
  gap: 12rpx;
}
.vote-group {
  display: flex;
  gap: 16rpx;
}
.vote {
  font-size: 24rpx;
  border-radius: 30rpx;
}
.on-agree {
  background: #67c23a;
  color: #fff;
}
.on-oppose {
  background: #f56c6c;
  color: #fff;
}
.item-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.link {
  color: #409eff;
  font-size: 24rpx;
}
.op-link {
  color: #409eff;
  font-size: 24rpx;
}
.op-link.danger {
  color: #f56c6c;
}

/* 理由 */
.reasons {
  margin-top: 20rpx;
  border-top: 1rpx dashed #ebeef5;
  padding-top: 16rpx;
}
.reason {
  display: flex;
  gap: 14rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f7fa;
}
.reason-floor {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #ecf5ff;
  color: #409eff;
  font-size: 22rpx;
  flex-shrink: 0;
}
.reason-main {
  min-width: 0;
}
.reason-content {
  font-size: 27rpx;
  color: #303133;
}
.reason-image {
  width: 220rpx;
  height: 160rpx;
  border-radius: 8rpx;
  margin-top: 10rpx;
}
.reason-foot {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
}
.reason-side {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  align-items: center;
  flex-shrink: 0;
}
.rv {
  font-size: 22rpx;
  color: #909399;
  padding: 4rpx 10rpx;
  border-radius: 20rpx;
  background: #f5f7fa;
}
.rv.on-agree { color: #fff; background: #67c23a; }
.rv.on-oppose { color: #fff; background: #f56c6c; }
.rv.danger { color: #f56c6c; }

/* 新增理由 */
.add-reason {
  margin-top: 16rpx;
}
.reason-input {
  width: 100%;
  box-sizing: border-box;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 26rpx;
  height: 120rpx;
}
.reason-tools {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
}
.img-pick {
  color: #409eff;
  font-size: 24rpx;
  border: 1rpx dashed #409eff;
  border-radius: 20rpx;
  padding: 6rpx 18rpx;
}
.img-prev {
  position: relative;
}
.prev-thumb {
  width: 72rpx;
  height: 72rpx;
  border-radius: 8rpx;
}
.prev-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 32rpx;
  height: 32rpx;
  line-height: 28rpx;
  text-align: center;
  background: #f56c6c;
  color: #fff;
  border-radius: 50%;
  font-size: 24rpx;
}
.submit-reason {
  margin-left: auto;
}

/* 弹层 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  z-index: 101;
  max-height: 80vh;
  overflow-y: auto;
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  text-align: center;
}
.field {
  margin-bottom: 24rpx;
}
.field.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.flabel {
  font-size: 26rpx;
  color: #606266;
  width: 140rpx;
  flex-shrink: 0;
}
.finput {
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  flex: 1;
}
.finput.num { max-width: 200rpx; }
.finput.picker { display: inline-block; }
.ftextarea {
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  height: 140rpx;
}
.cover-row {
  align-items: center;
}
.sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}
.sheet-actions button {
  flex: 1;
}

/* 预览 */
.preview {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.85);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}
.preview image {
  width: 100%;
}
