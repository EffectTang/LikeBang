.profile-page {
  padding: 24rpx;
  background: #f5f7fa;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ============ 头像区（view 定形 + 透明 button 叠加，根治椭圆） ============ */
.avatar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 20rpx;
}
.avatar-box {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #ecf0f5;
  box-sizing: border-box;
}
.avatar {
  width: 200rpx;
  height: 200rpx;
  display: block;
}
.avatar-ph {
  width: 200rpx;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 88rpx;
  color: #a8b3c5;
  line-height: 1;
}
/* 透明按钮铺满整个圆，用户点到任意位置都能触发 chooseAvatar；opacity:0 让它不可见但可点 */
.avatar-overlay {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  opacity: 0;
  line-height: 1;
  font-size: 0;
}
.avatar-overlay::after {
  border: none;
}
.avatar-tip {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #909399;
}
.avatar-remove {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #f56c6c;
}

/* ============ 行式卡片：左标签 · 中内容 · 右角标/编辑笔 ============ */
.cell {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-top: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.cell-label {
  flex-shrink: 0;
  width: 150rpx;
  font-size: 28rpx;
  color: #606266;
}
.cell-value {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  color: #303133;
  word-break: break-all;
}
.cell-input {
  flex: 1;
  min-width: 0;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 30rpx;
  color: #303133;
}
.ph {
  color: #c0c4cc;
  font-size: 28rpx;
}

/* 只读态：浅灰底 + 值转灰 + 右侧"不可修改"角标，明确不可动 */
.cell-readonly {
  background: #f2f4f7;
  box-shadow: none;
}
.cell-readonly .cell-value {
  color: #909399;
}
.cell-badge {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #909399;
  background: #e6e9ef;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
  line-height: 1;
}

/* 可编辑态：白底 + 蓝色 ✎ 笔图标，一眼看出可改 */
.cell-edit {
  flex-shrink: 0;
  font-size: 30rpx;
  color: #409eff;
  line-height: 1;
}

/* 多行文本卡片：走纵向布局 */
.cell-col {
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
}
.cell-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.cell-area {
  width: 100%;
  height: 160rpx;
  font-size: 30rpx;
  color: #303133;
  box-sizing: border-box;
}
.counter {
  text-align: right;
  font-size: 22rpx;
  color: #c0c4cc;
}

/* ============ 保存按钮 ============ */
.save-btn {
  margin-top: 40rpx;
  height: 88rpx;
  background: #409eff;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
