<view class="mine-page">
  <!-- 个人卡片（点击进入个人资料编辑） -->
  <view class="profile card" bindtap="goProfile">
    <block wx:if="{{isLogin}}">
      <image wx:if="{{avatarFull}}" class="avatar img" src="{{avatarFull}}" mode="aspectFill" />
      <view wx:else class="avatar">{{avatarChar}}</view>
      <view class="p-info flex-1">
        <view class="p-name">{{user.nickname || user.username}}</view>
        <view class="p-sub">@{{user.username}} · {{user.role === 1 ? '超级管理员' : (user.role === 2 ? '运营管理员' : '普通用户')}}</view>
      </view>
      <view class="p-edit">编辑 ›</view>
      <view class="logout" catchtap="logout">退出</view>
    </block>
    <block wx:else>
      <view class="avatar ph">👤</view>
      <view class="p-info flex-1">
        <view class="p-name">未登录</view>
        <view class="p-sub">登录后可发起榜单、投票、发理由</view>
      </view>
      <button class="btn-primary p-login" size="mini" bindtap="goLogin">登录 / 注册</button>
    </block>
  </view>

  <!-- 发起入口已上到底部 tab 栏，页内大按钮移除避免双入口稀释 -->

  <!-- 我的榜单 -->
  <view class="sec-title">我的榜单（{{total}}）</view>
  <view wx:for="{{list}}" wx:key="id" class="my-card card" data-id="{{item.id}}" bindtap="goDetail">
    <image wx:if="{{item.cover}}" class="my-cover" src="{{item.cover}}" mode="aspectFill" />
    <view wx:else class="my-cover ph">🏆</view>
    <view class="my-body flex-1">
      <view class="my-title">
        <text class="ellipsis flex-1">{{item.title}}</text>
        <text class="status s{{item.status}}">{{item.statusLabel}}</text>
      </view>
      <view class="my-meta">
        <text class="tag" wx:if="{{item.categoryName}}">{{item.categoryName}}</text>
        <text>🏆 Top {{item.itemLimit}}</text>
        <text>📋 {{item.itemCount}} 项</text>
        <text>👁 {{item.viewCount}}</text>
      </view>
    </view>
    <view class="my-del" catchtap="deleteRanking" data-id="{{item.id}}">删除</view>
  </view>

  <view wx:if="{{isLogin && loading}}" class="loading-tip">加载中…</view>
  <view wx:if="{{isLogin && !loading && list.length === 0}}" class="empty">你还没有榜单，从下方「发起榜单」创建第一个吧</view>
</view>
