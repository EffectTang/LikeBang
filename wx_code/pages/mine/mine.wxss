.mine-page {
  padding: 24rpx;
  /* 纵向 flex：内容不满屏时把「退出登录」推到 tabBar 正上方，消除底部空档；超屏时回退为普通滚动流 */
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ① 顶部 Hero 卡：渐变背景，整卡可点，编辑弱化在右上角 */
.hero {
  position: relative;
  background: linear-gradient(135deg, #409eff, #66b1ff);
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(64, 158, 255, 0.25);
  color: #fff;
}
.hero-edit {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  padding: 6rpx 12rpx;
}
.hero-main {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding-right: 96rpx; /* 给右上角编辑留白，避免文字压到 */
}
.hero-avatar {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  font-size: 48rpx;
  font-weight: 700;
  flex-shrink: 0;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  box-sizing: border-box;
}
.hero-avatar.img {
  background: #f0f2f5;
}
.hero-info {
  min-width: 0;
}
.hero-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.hero-name {
  font-size: 36rpx;
  font-weight: 700;
  max-width: 320rpx;
}
.hero-role {
  font-size: 20rpx;
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.25);
  flex-shrink: 0;
}
.hero-handle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 6rpx;
}
.hero-intro {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 10rpx;
}
.hero-intro.cta {
  color: rgba(255, 255, 255, 0.75);
}
.hero-login {
  margin-top: 24rpx;
}

/* ② 账号信息卡：只读行，label 左 value 右 */
.acct {
  padding-top: 12rpx;
}
.acct-title {
  margin: 8rpx 0 4rpx;
  color: #303133;
}
.acct .cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}
.acct .cell:last-child {
  border-bottom: none;
}
.cell-label {
  color: #909399;
  font-size: 26rpx;
}
.cell-value {
  color: #303133;
  font-size: 26rpx;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 8rpx 4rpx 16rpx;
}

.my-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.my-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.my-cover.ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #409eff, #66b1ff);
  font-size: 52rpx;
}
.my-body {
  min-width: 0;
}
.my-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.my-title .ellipsis {
  font-size: 30rpx;
  font-weight: 600;
}
.status {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}
.status.s1 { background: #e8f6ed; color: #67c23a; }
.status.s0 { background: #f0f2f5; color: #909399; }
.status.s2 { background: #fef0f0; color: #f56c6c; }
.my-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  color: #909399;
  font-size: 22rpx;
  margin-top: 10rpx;
}
.my-del {
  color: #f56c6c;
  font-size: 24rpx;
  padding: 10rpx;
  flex-shrink: 0;
}

/* ④ 退出登录：margin-top:auto 在 flex 列中钉到内容区底部（tabBar 正上方）；与顶部编辑物理隔离 */
.logout-bar {
  margin-top: auto;
  background: #fff;
  border-radius: 16rpx;
  text-align: center;
  color: #f56c6c;
  font-size: 28rpx;
  padding: 28rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 两行截断（Hero 个性签名） */
.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
