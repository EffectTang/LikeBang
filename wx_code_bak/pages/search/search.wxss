.page {
  padding: 24rpx;
}

/* 搜索表单：双常驻输入 */
.search-form {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.field {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.label {
  flex-shrink: 0;
  width: 110rpx;
  font-size: 26rpx;
  color: #606266;
}
.inp {
  flex: 1;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 0 20rpx;
  height: 72rpx;
  /* 原生 input 垂直位置由 line-height 决定：行高=框高才居中 */
  line-height: 72rpx;
  font-size: 28rpx;
}
.go-btn {
  margin-top: 8rpx;
  background: #409eff;
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  height: 80rpx;
  /* button 文字居中用 flex，不依赖 line-height */
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

/* 最近搜索 */
.hist-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  color: #606266;
  margin: 8rpx 4rpx 16rpx;
}
.hist-clear {
  color: #909399;
  font-size: 24rpx;
}
.hist-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.chip {
  background: #fff;
  color: #606266;
  font-size: 26rpx;
  border-radius: 28rpx;
  padding: 10rpx 26rpx;
}

.res-count {
  font-size: 24rpx;
  color: #909399;
  margin: 0 4rpx 16rpx;
}

/* 结果卡片：与发现页 rank-card 同款 */
.rank-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.card-cover {
  display: block;
  width: 100%;
  height: 260rpx;
}
.cover-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #409eff 0%, #66b1ff 100%);
  font-size: 72rpx;
}
.card-body {
  padding: 20rpx 24rpx 24rpx;
}
.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #303133;
}
.card-desc {
  color: #909399;
  font-size: 26rpx;
  margin: 8rpx 0 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.card-meta {
  display: flex;
  gap: 28rpx;
  color: #606266;
  font-size: 24rpx;
}
.card-foot {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}
.creator {
  color: #409eff;
  font-size: 24rpx;
}
