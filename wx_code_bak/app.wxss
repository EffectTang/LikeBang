/* 全局样式：与 Web 端（Element 蓝 #409eff）配色对齐 */
page {
  background: #f5f7fa;
  color: #303133;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, sans-serif;
}

.container {
  padding: 24rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 主按钮 */
.btn-primary {
  background: #409eff;
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  border: none;
}
.btn-primary[disabled] {
  background: #a0cfff;
  color: #fff;
}
.btn-plain {
  background: #fff;
  color: #409eff;
  border: 1rpx solid #409eff;
  border-radius: 40rpx;
  font-size: 28rpx;
}
.btn-danger {
  background: #f56c6c;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
}

/* 文本工具类 */
.muted {
  color: #909399;
  font-size: 24rpx;
}
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.row {
  display: flex;
  align-items: center;
}
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.flex-1 {
  flex: 1;
  min-width: 0;
}

/* 空态 / 加载 */
.empty {
  text-align: center;
  color: #c0c4cc;
  padding: 80rpx 0;
  font-size: 26rpx;
}
.loading-tip {
  text-align: center;
  color: #909399;
  padding: 24rpx 0;
  font-size: 24rpx;
}

/* 标签徽章 */
.tag {
  display: inline-block;
  padding: 2rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  background: #ecf5ff;
  color: #409eff;
  margin-right: 12rpx;
}
